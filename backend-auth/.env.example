PORT=8000
BASE_URL=/api/v1

# Database (required)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-url>/backend-auth?appName=Cluster0
MONGODB_USE_MEMORY=false

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

EMAIL_VERIFICATION_EXPIRES_HOURS=24

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Real inbox mail (Gmail recommended) ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Auth API <your-email@gmail.com>"
